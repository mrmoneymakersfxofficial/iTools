# ─── Supabase PostgreSQL (Production) ───
# Transaction pooler (for Vercel serverless runtime — port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Session mode pooler (for Prisma migrations — port 5432 on pooler host)
# ⚠️ Do NOT use db.<ref>.supabase.co:5432 — Vercel can't reach it!
# Use the pooler host with port 5432 (session mode) instead
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Sanity CMS ───
SANITY_REVALIDATE_SECRET=itools2024
NEXT_PUBLIC_SANITY_PROJECT_ID=kytfgk41
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ─── NextAuth ───
NEXTAUTH_SECRET=itools-nextauth-secret-change-me
NEXTAUTH_URL=https://i-tools-steel.vercel.app

# ─── Google OAuth (optional — login button only appears if set) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

